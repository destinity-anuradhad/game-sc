@{ ViewData["Title"] = "Admin sign in"; }
<section class="page-hero wrap"><div class="eyebrow">ADMIN ACCESS</div><h1>Control <em>room.</em></h1><p>Sign in to manage tournament registrations, standings, matches and heats.</p></section>
<section class="section wrap" style="max-width:560px;padding-top:0;padding-bottom:100px"><form class="registration-form" method="post" action="/admin/login">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div>@if(ViewData["Error"] is string error){<p class="validation-summary">@error</p>}<div class="form-section"><div class="field"><label for="password">ADMIN PASSWORD</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div><button class="button button-lime" type="submit">Sign in ↗</button></div></form></section>
