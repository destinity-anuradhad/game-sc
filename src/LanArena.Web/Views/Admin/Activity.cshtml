@model IReadOnlyList<LanArena.Infrastructure.AdminAuditLogEntity>
@{ ViewData["Title"] = "Activity log"; }
@section Styles {
    <link rel="stylesheet" href="~/css/admin-audit.css" asp-append-version="true" />
}
<div class="admin-audit-wrap">
    <header class="admin-audit-header">
        <div>
            <div class="admin-kicker"><i></i> ADMINISTRATION <span>·</span> AUDIT TRAIL</div>
            <h1>Activity <em>log.</em></h1>
            <p>Administrative changes with the account, time, client IP, and before/after values.</p>
        </div>
        <a class="admin-audit-back" asp-controller="Admin" asp-action="Index">← Registration desk</a>
    </header>
    <div class="admin-audit-summary"><strong>@Model.Count</strong><span>most recent events shown</span><span class="admin-audit-retention">Up to 500 events</span></div>
    @if (Model.Count == 0)
    {
        <div class="admin-audit-empty"><span>NO ACTIVITY RECORDED</span><p>Successful sign-ins, sign-outs, and registration changes will appear here.</p></div>
    }
    else
    {
        <div class="admin-audit-list">
            @foreach (var entry in Model)
            {
                <article class="admin-audit-entry">
                    <div class="admin-audit-entry-main">
                        <div class="admin-audit-action"><span class="admin-audit-marker"></span><div><span class="admin-audit-type">@entry.EntityType · @entry.EntityId</span><h2>@entry.Action</h2></div></div>
                        <div class="admin-audit-target"><span>RECORD</span><b>@entry.EntityName</b></div>
                        <div class="admin-audit-actor"><span>ADMIN</span><b>@entry.AdminUser</b></div>
                        <div class="admin-audit-ip"><span>CLIENT IP</span><b>@entry.ClientIp</b></div>
                        <div class="admin-audit-ip admin-audit-server"><span>SERVER IP</span><b>@entry.ServerIp</b></div>
                        <time datetime="@entry.OccurredAt.ToString("O")">@entry.OccurredAt.ToString("dd MMM yyyy · HH:mm:ss") UTC</time>
                    </div>
                    <details class="admin-audit-details">
                        <summary>View changed details <span aria-hidden="true">⌄</span></summary>
                        <pre>@entry.DetailsJson</pre>
                    </details>
                </article>
            }
        </div>
    }
</div>
