@model PublicTournamentSnapshot
@{ ViewData["Title"] = "Schedule"; }
<section class="page-hero wrap"><div class="eyebrow">EVENT OPERATIONS <span>WEDNESDAY · @Model.EventDate.ToString("dd MMM yyyy").ToUpperInvariant()</span></div><h1>The <em>schedule.</em></h1><p>Every match, every heat. All times local to Colombo.</p><div class="page-meta"><span>@Model.Venue</span><span>GMT +5:30</span><span>Updated automatically</span></div></section>
<section class="section wrap table-section"><div class="section-heading"><div><div class="eyebrow">01 · TACTICAL TEAM PLAY</div><h2>Call of Duty <em>4.</em></h2></div><a class="button button-lime" asp-controller="Cod4Registration" asp-action="Create">Register a team ↗</a></div><div class="data-table"><div class="table-row table-header"><span>MATCH</span><span>FIXTURE</span><span>MODE / MAP</span><span>SERVER</span><span>STATUS</span></div>@foreach(var match in Model.Matches.OrderBy(m=>m.Time)){<div class="table-row"><span class="mono muted">@match.Id<br /><small>@match.Time</small></span><span class="fixture"><b>@match.TeamA</b><i>VS</i><b>@match.TeamB</b>@if(match.Status=="Live"){<small>@match.ScoreA — @match.ScoreB</small>}</span><span>@match.Mode <small class="cell-sub">@match.Map</small></span><span>@match.Server</span><span><i class="status-dot @(match.Status=="Live"?"is-live":"")"></i>@match.Status</span></div>}</div></section>
<section class="section wrap table-section"><div class="section-heading"><div><div class="eyebrow">02 · INDIVIDUAL RACING</div><h2>Need for <em>Speed.</em></h2></div><a class="button button-outline" asp-controller="NfsRegistration" asp-action="Create">Register a racer ↗</a></div><div class="data-table"><div class="table-row table-header"><span>HEAT</span><span>RACE FORMAT</span><span>TRACK</span><span>GRID</span><span>STATUS</span></div>@foreach(var heat in Model.Heats.OrderBy(h=>h.Time)){<div class="table-row"><span class="mono muted">@heat.Id<br /><small>@heat.Time</small></span><span>@heat.Type</span><span><b>@heat.Track</b></span><span>@string.Join(" · ",heat.Racers)</span><span><i class="status-dot @(heat.Status=="Racing"?"is-live orange-dot":"")"></i>@heat.Status</span></div>}</div></section>
