@model PublicTournamentSnapshot
@{ ViewData["Title"] = "COD4 Leaderboard"; var teams = Model.Teams.OrderByDescending(t=>t.Points).ThenByDescending(t=>t.ScoreDifference).ThenByDescending(t=>t.Wins).ToList(); }
<section class="page-hero wrap"><div class="eyebrow">LIVE STANDINGS <span>COD4 · GROUP STAGE</span></div><h1>Team <em>leaderboard.</em></h1><p>Three points for a win. Every round counts.</p><div class="page-meta"><span>Points → head-to-head → round difference</span><span>Standings shown as of page load</span></div></section><section class="section wrap table-section"><div class="data-table"><div class="table-row cod-table table-header"><span>RANK</span><span>TEAM</span><span>PLAYED</span><span>W</span><span>L</span><span>DIFF</span><span>PTS</span></div>@foreach(var (team,index) in teams.Select((t,i)=>(t,i))){<div class="table-row cod-table"><span class="rank">@(index+1<10?$"0{index+1}":$"{index+1}")</span><span class="leader-name"><b>@team.Name</b><small>@team.ShortName · Captain @team.Captain</small></span><span>@team.Played</span><span>@team.Wins</span><span>@team.Losses</span><span>@(team.ScoreDifference>0?"+":"")@team.ScoreDifference</span><strong>@team.Points</strong></div>}</div></section>
