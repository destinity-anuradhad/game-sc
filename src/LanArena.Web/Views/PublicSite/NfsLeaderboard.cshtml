@model PublicTournamentSnapshot
@{ ViewData["Title"] = "NFS Leaderboard"; var racers = Model.Racers.OrderByDescending(r=>r.Points).ThenByDescending(r=>r.Wins).ThenByDescending(r=>r.SecondPlaces).ThenByDescending(r=>r.ThirdPlaces).ToList(); }
<section class="page-hero wrap"><div class="eyebrow">CHAMPIONSHIP STANDINGS <span>NFS · MOST WANTED 2005</span></div><h1>The <em>championship.</em></h1><p>Points decide the title. Race wins break the tie.</p><div class="page-meta"><span>10 · 7 · 5 · 3 points by finishing position</span><span>Standings shown as of page load</span></div></section><section class="section wrap table-section"><div class="data-table"><div class="table-row nfs-table table-header"><span>RANK</span><span>DRIVER</span><span>RACES</span><span>1ST</span><span>2ND</span><span>3RD</span><span>PTS</span></div>@foreach(var (racer,index) in racers.Select((r,i)=>(r,i))){<div class="table-row nfs-table"><span class="rank">@(index+1<10?$"0{index+1}":$"{index+1}")</span><span class="leader-name"><b>@racer.Nickname</b><small>@racer.Code · @racer.FullName</small></span><span>@racer.Races</span><span>@racer.Wins</span><span>@racer.SecondPlaces</span><span>@racer.ThirdPlaces</span><strong>@racer.Points</strong></div>}</div></section>
