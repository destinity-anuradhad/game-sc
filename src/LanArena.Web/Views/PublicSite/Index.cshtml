@model PublicTournamentSnapshot
@{ ViewData["Title"] = "Event"; var liveMatch = Model.Matches.FirstOrDefault(m => m.Status == "Live"); var liveHeat = Model.Heats.FirstOrDefault(h => h.Status == "Racing"); var countdownTarget = Model.RegistrationEndsAt.ToString("yyyy-MM-dd'T'HH:mm:sszzz"); }
<section class="hero wrap">
    <div class="hero-copy"><div class="event-label"><span class="live-dot"></span> @Model.Venue.ToUpperInvariant() <i></i> TOURNAMENT DAY</div><h1>One arena.<br /><span>Two legends.</span></h1><p>COD4 Promod meets Need for Speed: Most Wanted. The city’s LAN battleground starts here.</p><div class="hero-buttons"><a class="button button-lime registration-primary" href="#register">Register now <span>↗</span></a><a class="button button-outline" asp-controller="PublicSite" asp-action="Rules">Game Rules <span>→</span></a></div></div>
    <aside class="hero-countdown" aria-label="Registration countdown">
        <div class="countdown-heading"><span class="countdown-live-dot"></span><span>REGISTRATION WINDOW</span></div>
        <h2>Registration ends in</h2>
        <div class="countdown-grid" data-countdown-target="@countdownTarget" aria-label="Countdown to registration deadline">
            <div class="countdown-unit"><strong data-countdown-days>--</strong><span>DAYS</span></div>
            <div class="countdown-unit"><strong data-countdown-hours>--</strong><span>HOURS</span></div>
            <div class="countdown-unit"><strong data-countdown-minutes>--</strong><span>MINUTES</span></div>
            <div class="countdown-unit"><strong data-countdown-seconds>--</strong><span>SECONDS</span></div>
        </div>
        <p>@Model.RegistrationEndsAt.ToString("dd MMMM yyyy").ToUpperInvariant() <i></i> @Model.RegistrationEndsAt.ToString("hh:mm tt").ToUpperInvariant() LKT</p>
        <nav class="entry-counts" aria-label="Registered entries">
            <a class="entry-count entry-count-cod" asp-controller="PublicSite" asp-action="Teams"><span class="entry-count-game">COD4</span><strong>@Model.Teams.Count</strong><span class="entry-count-label">TEAMS REGISTERED</span><span class="entry-count-arrow" aria-hidden="true">↗</span></a>
            <a class="entry-count entry-count-nfs" asp-controller="PublicSite" asp-action="Racers"><span class="entry-count-game">NFS</span><strong>@Model.Racers.Count</strong><span class="entry-count-label">RACERS REGISTERED</span><span class="entry-count-arrow" aria-hidden="true">↗</span></a>
        </nav>
    </aside>
</section>
<section class="ticker"><div class="ticker-track"><span>CALL OF DUTY 4</span><b>✳</b><span>NEED FOR SPEED: MOST WANTED</span><b>✳</b><span>Scienter Welfare Team</span><b>✳</b><span>CALL OF DUTY 4</span><b>✳</b><span>NEED FOR SPEED: MOST WANTED</span></div></section>
<section class="section wrap registration-arena" id="register"><div class="registration-topline"><span><i class="live-dot"></i> PLAYER ENTRY PORTAL</span><span>01 <b>COD4</b><i></i>02 <b>NFS</b></span></div><div class="section-heading"><div><div class="eyebrow">PICK YOUR BATTLEGROUND <span>01 — 02</span></div><h2>Choose your <em>game.</em></h2></div><p>Bring your squad or race under your own name.<br />There’s a place for you in the arena.</p></div><div class="game-grid">
    <article class="game-card cod-card"><div class="card-top"><span class="game-number">01 / TEAM COMPETITION</span><span class="game-symbol">C<span>4</span></span></div><div class="game-content"><span class="game-tag">TACTICAL · 5V5</span><h3>Call of Duty 4</h3><p>Promod. Tight rounds, clean comms, no second chances. Build your roster and take the server.</p><div class="game-facts"><span><b>02</b> MODES</span><span><b>05</b> MAIN PLAYERS</span><span><b>03</b> PTS / WIN</span></div><div class="game-card-actions"><a class="button button-light" asp-controller="Cod4Registration" asp-action="Create">Register your team <span>↗</span></a><a class="game-rules-link" asp-controller="PublicSite" asp-action="Rules" asp-fragment="panel-cod4">COD4 rules <span>↗</span></a></div></div><div class="card-watermark">COD</div></article>
    <article class="game-card nfs-card"><div class="card-top"><span class="game-number">02 / SOLO CHAMPIONSHIP</span><span class="game-symbol">N<span>FS</span></span></div><div class="game-content"><span class="game-tag">STREET RACING · 4 PER HEAT</span><h3>Need for Speed</h3><p>Most Wanted, 2005. Four race formats, one championship. Get on the grid and make it yours.</p><div class="game-facts"><span><b>04</b> RACE TYPES</span><span><b>04</b> RACERS / HEAT</span><span><b>10</b> PTS / WIN</span></div><div class="game-card-actions"><a class="button button-light" asp-controller="NfsRegistration" asp-action="Create">Register as a racer <span>↗</span></a><a class="game-rules-link" asp-controller="PublicSite" asp-action="Rules" asp-fragment="panel-nfs">NFS rules <span>↗</span></a></div></div><div class="card-watermark">MW</div></article>
</div></section>
<section class="section live-section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">FROM THE ARENA <span>LIVE DESK</span></div><h2>Happening <em>now.</em></h2></div><a class="under-link" asp-controller="PublicSite" asp-action="Schedule">Full schedule <span>↗</span></a></div><div class="live-grid"><article class="live-card"><div class="live-card-head"><span><i class="live-dot"></i> COD4 · SERVER 01</span><b>LIVE</b></div>@if (liveMatch is not null){<div class="live-game-title">Search &amp; Destroy <span>· @liveMatch.Map</span></div><div class="scoreboard"><div><small>@liveMatch.TeamA</small><strong>@liveMatch.ScoreA</strong></div><i>:</i><div><small>@liveMatch.TeamB</small><strong>@liveMatch.ScoreB</strong></div></div><div class="live-foot"><span>@liveMatch.Id</span><span>@liveMatch.Server · @liveMatch.Time</span></div>}else{<div class="empty-live">No match is live right now. Check the schedule for what’s next.</div>}</article><article class="live-card race-live"><div class="live-card-head"><span><i class="live-dot orange"></i> NFS · RACE CONTROL</span><b>ON TRACK</b></div>@if(liveHeat is not null){<div class="live-game-title">@liveHeat.Id <span>· @liveHeat.Type</span></div><div class="track-name">@liveHeat.Track</div><div class="race-order">@for(var i=0;i<liveHeat.Racers.Count;i++){<div><span>@((i+1).ToString("00"))</span><b>@liveHeat.Racers[i]</b><small>@(i==0?"LEADING":"RACING")</small></div>}</div><div class="live-foot"><span>4 RACERS ON GRID</span><span>LIVE ORDER</span></div>}else{<div class="empty-live">No race is live right now.</div>}</article></div></div></section>
<section class="section wrap"><div class="section-heading"><div><div class="eyebrow">THE BOARD <span>LIVE STANDINGS</span></div><h2>Chase the <em>top.</em></h2></div><a class="under-link" asp-controller="PublicSite" asp-action="NfsLeaderboard">All leaderboards <span>↗</span></a></div><div class="leader-preview"><div class="leader-panel"><div class="leader-head"><b>COD4 / TEAM TABLE</b><a asp-controller="PublicSite" asp-action="Cod4Leaderboard">FULL TABLE ↗</a></div><div class="leader-row leader-label"><span>RANK</span><span>TEAM</span><span>PLAYED</span><span>W/L</span><span>PTS</span></div>@foreach(var (team,index) in Model.Teams.OrderByDescending(t=>t.Points).ThenByDescending(t=>t.ScoreDifference).Take(3).Select((t,i)=>(t,i))){<div class="leader-row"><span class="rank">@(index+1<10?$"0{index+1}":$"{index+1}")</span><span class="leader-name"><b>@team.Name</b><small>@team.ShortName · @team.Captain</small></span><span>@team.Played</span><span>@team.Wins / @team.Losses</span><strong>@team.Points</strong></div>}</div><div class="leader-panel nfs-leader-panel"><div class="leader-head"><b>NFS / CHAMPIONSHIP</b><a asp-controller="PublicSite" asp-action="NfsLeaderboard">FULL TABLE ↗</a></div><div class="leader-row leader-label"><span>RANK</span><span>RACER</span><span>WINS</span><span>RACES</span><span>PTS</span></div>@foreach(var (racer,index) in Model.Racers.OrderByDescending(r=>r.Points).ThenByDescending(r=>r.Wins).Take(3).Select((r,i)=>(r,i))){<div class="leader-row"><span class="rank">@(index+1<10?$"0{index+1}":$"{index+1}")</span><span class="leader-name"><b>@racer.Nickname</b><small>@racer.Code · @racer.FullName</small></span><span>@racer.Wins</span><span>@racer.Races</span><strong>@racer.Points</strong></div>}</div></div></section>
<section class="bottom-cta"><div class="wrap bottom-cta-inner"><div><div class="eyebrow">REGISTRATION IS OPEN <span>DON’T MISS YOUR GRID</span></div><h2>Your name belongs <em>up there.</em></h2></div><div><a class="button button-lime registration-primary" href="#register">Register now <span>↗</span></a><span class="deadline">DEADLINE · @Model.RegistrationEndsAt.ToString("dd MMMM · hh:mm tt").ToUpperInvariant() LKT</span></div></div></section>

