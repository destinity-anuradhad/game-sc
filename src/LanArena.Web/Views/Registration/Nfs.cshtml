@model NfsRegistrationInput
@{ ViewData["Title"] = "NFS Racer Registration"; }
<section class="page-hero wrap"><div class="eyebrow">NEED FOR SPEED · INDIVIDUAL ENTRY <span>MOST WANTED · 2005</span></div><h1>Get on the <em>grid.</em></h1><p>One driver. Four racers per heat. Your championship starts with this entry.</p></section>
<section class="section wrap form-layout"><form asp-controller="NfsRegistration" asp-action="Create" method="post" class="registration-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-section"><div class="form-section-heading"><span>01</span><div><h2>Driver details</h2><p>Use the name and nickname you want shown during the event.</p></div></div><div class="form-grid"><div class="field"><label asp-for="FullName">FULL NAME <i>REQUIRED</i></label><input asp-for="FullName" placeholder="Your full name" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Nickname">RACING NICKNAME <i>SHOWN IN GAME</i></label><input asp-for="Nickname" placeholder="e.g. KAZ" maxlength="24" /><span asp-validation-for="Nickname"></span></div><div class="field"><label asp-for="Phone">PHONE NUMBER</label><input asp-for="Phone" placeholder="+94 77 123 4567" autocomplete="tel" /><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="Email">EMAIL <i>OPTIONAL</i></label><input asp-for="Email" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field full"><label asp-for="StudentId">NIC / STUDENT ID <i>OPTIONAL · PER EVENT POLICY</i></label><input asp-for="StudentId" placeholder="Enter if required at check-in" /></div></div></div><div class="form-section rules-box"><label class="check-label"><input asp-for="AcceptRules" /><span>I agree to follow the <a asp-controller="PublicSite" asp-action="Rules">event’s fair play rules</a>, including the standard car and setup.</span></label><span asp-validation-for="AcceptRules"></span></div><div class="form-submit"><p>Registration status: <b>Pending admin review</b><br />Your unique player code is assigned automatically.</p><button class="button button-lime" type="submit">Submit racer registration <span>↗</span></button></div></form><aside class="form-aside"><div class="aside-sticky"><div class="eyebrow">RACE DAY RULES</div><h3>Same car.<br /><em>Same chance.</em></h3><ul><li><span>01</span> Tournament standard car</li><li><span>02</span> Matched upgrades and tuning</li><li><span>03</span> Four players in every race heat</li><li><span>04</span> Finish position earns points</li></ul><div class="points-card"><small>CHAMPIONSHIP POINTS</small><div><b>10</b><span>1ST</span><b>7</b><span>2ND</span><b>5</b><span>3RD</span><b>3</b><span>4TH</span></div></div></div></aside></section>
